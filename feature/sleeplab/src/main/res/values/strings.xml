<resources>
    <string name="sleeplab_title">Sleep Lab</string>

    <!-- Loading, empty and error states of the whole screen -->
    <string name="sleeplab_loading">Reading your sleep data…</string>
    <string name="sleeplab_empty_title">Nothing to analyse yet</string>
    <string name="sleeplab_empty_body">There is no pair of snapshots for this period yet. Keep using your phone, then refresh.</string>
    <string name="sleeplab_empty_refresh">Refresh</string>
    <string name="sleeplab_error_title">Couldn\'t analyse this period</string>
    <string name="sleeplab_error_body">Something went wrong while reading your battery history. Try again in a moment.</string>
    <string name="sleeplab_error_retry">Try again</string>
    <string name="sleeplab_refresh_failed">Couldn\'t refresh. Is Shizuku or Sui running?</string>

    <!-- Hypnogram card -->
    <string name="sleeplab_hypnogram_title">Screen-off sleep</string>
    <string name="sleeplab_hypnogram_subtitle">Doze stages and wake-ups while the screen was off</string>
    <string name="sleeplab_hypnogram_loading">Reading the history…</string>
    <string name="sleeplab_hypnogram_failed_title">Couldn\'t read the history</string>
    <string name="sleeplab_hypnogram_failed_body">The battery history for this period could not be loaded.</string>
    <string name="sleeplab_hypnogram_empty_title">No screen-off doze data</string>
    <string name="sleeplab_hypnogram_empty_body">This period has no screen-off time with recorded doze, or it has not been collected yet.</string>
    <!-- %1$s: the number of wake-ups -->
    <plurals name="sleeplab_wakeups">
        <item quantity="one">%1$s wake-up</item>
        <item quantity="other">%1$s wake-ups</item>
    </plurals>
    <string name="sleeplab_hypnogram_note_wakeups">A wake-up marks a screen-on or a doze exit; it doesn\'t say what caused it.</string>
    <string name="sleeplab_hypnogram_note">Hatched areas mean the screen was on or nothing was recorded. A wake-up marks a screen-on or a doze exit; it doesn\'t say what caused it.</string>

    <!-- Culprit card: TEMPLATE.md §4 Rule 2, screen-off awake share over 8 % -->
    <string name="sleeplab_culprit_title">Kept awake with the screen off</string>
    <!-- %1$s: the rule's threshold as a percentage figure, e.g. "20" -->
    <string name="sleeplab_culprit_severity_red">Severe · over %1$s%% awake</string>
    <!-- %1$s: the rule's threshold as a percentage figure, e.g. "8" -->
    <string name="sleeplab_culprit_severity_amber">High · over %1$s%% awake</string>
    <!-- %1$s: time awake, %2$s: total screen-off time, e.g. "50 min" and "9 h" -->
    <string name="sleeplab_culprit_awake_detail">Awake %1$s of %2$s with the screen off</string>
    <string name="sleeplab_culprit_scope_screen_off">The culprits below were counted while the screen was off.</string>
    <string name="sleeplab_culprit_scope_whole">This period also has screen-on time, so the culprits below were counted over the whole period, not only while the screen was off.</string>
    <string name="sleeplab_culprit_kind_partial">App wakelock</string>
    <string name="sleeplab_culprit_kind_kernel">Kernel wakelock</string>
    <string name="sleeplab_culprit_kind_alarm">Wake-up alarm</string>
    <string name="sleeplab_culprit_kind_wakeup_reason">Wake-up reason</string>
    <string name="sleeplab_culprit_none">No wakelock or alarm stands out in this period\'s counters.</string>
    <string name="sleeplab_culprit_needs_full_body">App wakelocks and alarms need a full snapshot at both ends of the period, so only kernel wakelocks are listed. Pull down to refresh, then check back as more snapshots are collected.</string>
    <!-- %1$s: the number of apps -->
    <plurals name="sleeplab_culprit_skipped_apps">
        <item quantity="one">%1$s app wasn\'t checked because its counters reset during the period.</item>
        <item quantity="other">%1$s apps weren\'t checked because their counters reset during the period.</item>
    </plurals>
    <string name="sleeplab_culprit_action_standby_bucket">To limit it: Toolkit › App background control › Standby bucket › Rare or Restricted.</string>
    <string name="sleeplab_culprit_action_wake_lock">To limit it: Toolkit › App background control › Restrict wakelocks. Alarms and messaging may break.</string>
    <string name="sleeplab_culprit_action_dexopt">Toolkit › Background dexopt shows whether it is running and can start or cancel it.</string>
    <string name="sleeplab_culprit_skipped_title">Couldn\'t check what kept it awake</string>
    <!-- %1$s: the shortest screen-off time the check needs, e.g. "30 min" -->
    <string name="sleeplab_culprit_skipped_short">This period has less than %1$s of screen-off time, too little to tell what kept the phone awake. Pick a longer period, such as a night.</string>
    <string name="sleeplab_culprit_skipped_no_awake">Battery stats recorded no awake time for this period\'s screen-off time, so it can\'t be checked.</string>
    <string name="sleeplab_culprit_skipped_other">The screen-off awake check couldn\'t run for this period.</string>

