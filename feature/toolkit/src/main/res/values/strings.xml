    <string name="toolkit_doze_balanced">Balanced</string>
    <string name="toolkit_doze_balanced_body">Enters deep doze sooner once the phone is still. Notifications can arrive a little later while it is idle.</string>
    <string name="toolkit_doze_aggressive">Aggressive night</string>
    <string name="toolkit_doze_aggressive_body">Enters deep doze quickly, even while the phone is moving. Alarms and messages can be delayed a lot.</string>
