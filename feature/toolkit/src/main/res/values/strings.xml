    <!-- Doze -->
    <string name="toolkit_doze_title">Doze profiles</string>
    <string name="toolkit_doze_experimental">Experimental</string>
    <string name="toolkit_doze_intro">A profile changes how soon the phone enters deep doze when it sits idle. Profiles are experimental: watch your battery for a few days before you keep one.</string>
